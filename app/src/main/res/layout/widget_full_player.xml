<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_dark"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/widget_artwork_background"
            android:clipToOutline="true"
            android:contentDescription="@string/widget_album_art"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_music_note" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_now_playing"
                android:textColor="#B8B5BE"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_nothing_playing"
                android:textColor="#FFF5F5F5"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_open_sonora_to_play"
                android:textColor="#B8B5BE"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="28dp"
                    android:text="0:00"
                    android:textColor="#B8B5BE"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/widget_progress"
                    android:layout_width="0dp"
                    android:layout_height="14dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/widget_playback_progress"
                    android:scaleType="fitXY" />

                <TextView
                    android:id="@+id/widget_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="28dp"
                    android:gravity="end"
                    android:text="0:00"
                    android:textColor="#B8B5BE"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_repeat_background"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/widget_repeat_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_repeat"
                android:padding="10dp"
                android:src="@drawable/widget_repeat"
                android:tint="#FFFFFFFF" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_previous_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_control_background"
                android:contentDescription="@string/widget_previous"
                android:padding="10dp"
                android:src="@drawable/widget_previous"
                android:tint="#FFFFFFFF" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp">

            <ImageView
                android:id="@+id/widget_play_circle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_toggle_playback"
                android:scaleType="fitXY"
                android:src="@drawable/widget_play_circle" />

            <ImageView
                android:id="@+id/widget_play_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:padding="12dp"
                android:src="@drawable/widget_play"
                android:tint="#FFFFFFFF" />

            <ImageView
                android:id="@+id/widget_pause_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:padding="12dp"
                android:src="@drawable/widget_pause"
                android:tint="#FFFFFFFF"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_next_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_control_background"
                android:contentDescription="@string/widget_next"
                android:padding="10dp"
                android:src="@drawable/widget_next"
                android:tint="#FFFFFFFF" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_shuffle_background"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:scaleType="fitXY" />

            <ImageView
                android:id="@+id/widget_shuffle_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@string/widget_shuffle"
                android:padding="10dp"
                android:src="@drawable/widget_shuffle"
                android:tint="#FFFFFFFF" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
